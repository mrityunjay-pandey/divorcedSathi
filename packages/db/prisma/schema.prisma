// DivorcedSathi.com — Prisma schema
//
// Models are added module-by-module so migrations stay small and reviewable.
// See docs/ARCHITECTURE.md §3 for the full planned entity list; only the
// entities needed by completed modules exist below (Module 2: User/auth).
//
// Still to come: Profile, ProfilePhoto, PartnerPreference, PreviousMarriage,
// Child, Lifestyle, Education, Career, Interest, Match, Shortlist,
// Conversation, Message, Notification, Verification, Report, Block,
// Subscription, Payment, AdminUser (role folded into User for now), AuditLog,
// PrivacySetting, SavedSearch, ProfileView.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Module 2 — Authentication
// ---------------------------------------------------------------------------
// Deliberately minimal: this is the identity/credential surface only.
// Matrimonial profile data (Module 4+) lives in its own tables so a leak or
// bug in profile code can never touch credentials, and so account deletion
// (Module 13/§39) can cascade cleanly.

enum AuthIdentifierType {
  EMAIL
  MOBILE
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String?
  email         String?  @unique
  mobileNumber  String?  @unique
  passwordHash  String
  dateOfBirth   DateTime
  gender        Gender
  city          String
  marriageStatus MarriageStatus @default(DIVORCED)
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  role          UserRole @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshSessions RefreshSession[]
  otpCodes        OtpCode[]
  profile         Profile?

  interestsSent     Interest[] @relation("InterestsSent")
  interestsReceived Interest[] @relation("InterestsReceived")
  shortlistedBy     Shortlist[] @relation("ShortlistOwner")
  shortlistedByOthers Shortlist[] @relation("ShortlistTarget")
  matchesAsA        Match[]    @relation("MatchUserA")
  matchesAsB        Match[]    @relation("MatchUserB")
  messagesSent      Message[]  @relation("MessageSender")
  notifications     Notification[]
  verifications     Verification[]  @relation("VerificationSubject")
  verificationsReviewed Verification[] @relation("VerificationReviewer")
  reportsMade       Report[]        @relation("ReportReporter")
  reportsReceived   Report[]        @relation("ReportSubject")
  reportsReviewed   Report[]        @relation("ReportReviewer")
  blocksInitiated   Block[]         @relation("BlockInitiator")
  blocksReceived    Block[]         @relation("BlockTarget")
  auditLogsAsActor  AuditLog[]      @relation("AuditActor")
  subscription      Subscription?
  payments          Payment[]

  @@index([email])
  @@index([mobileNumber])
  @@index([gender])
  @@index([marriageStatus])
  @@index([dateOfBirth])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// MVP scope is divorced-only (brief §3/§9); the enum leaves room for the
/// "Potential future categories" the brief names (widowed, separated,
/// annulled) without a schema migration when they're added.
enum MarriageStatus {
  DIVORCED
  WIDOWED
  SEPARATED
  ANNULLED
}

/// One row per issued refresh token, so a single device/session can be
/// revoked (logout) without invalidating every session (logout-everywhere
/// deletes all rows for the user instead).
model RefreshSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
}

/// Short-lived one-time codes for mobile/email verification and login.
/// Never store the raw code — only its hash — so a DB read can't leak a
/// usable credential.
model OtpCode {
  id            String             @id @default(uuid())
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifierType AuthIdentifierType
  identifier    String
  codeHash      String
  purpose       OtpPurpose
  attempts      Int                @default(0)
  maxAttempts   Int                @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime           @default(now())

  @@index([identifier, purpose])
  @@index([userId])
}

enum OtpPurpose {
  REGISTRATION_VERIFY
  LOGIN
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Module 3 — Base matrimonial profile
// ---------------------------------------------------------------------------
// Deliberately separate from User (brief §44: "Do not put everything into one
// giant User table"). Basic Info (brief §11) plus About Me (§12, added in
// Module 4) live here; Previous Marriage/Family/Lifestyle/Partner
// Preferences/Photos each get their own table so this one doesn't grow
// without bound.

model Profile {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  heightCm       Int?
  city           String
  state          String?
  country        String          @default("India")
  motherTongue   String?
  religion       String?
  community      String?
  education      String?
  profession     String?
  employmentType EmploymentType?
  incomeRange    IncomeRange?

  /// Free-text "About Me" (brief §12). Length-capped at the DTO layer, not
  /// here — Postgres TEXT has no practical limit, so validation is the
  /// right place to enforce a UX-sane maximum.
  aboutMe        String?         @db.Text

  lifestyle      Lifestyle?
  previousMarriage PreviousMarriage?
  familyDetails    FamilyDetails?
  partnerPreference PartnerPreference?
  privacySetting   PrivacySetting?
  photos           ProfilePhoto[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([city])
  @@index([religion])
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS_OWNER
  NOT_WORKING
  PREFER_NOT_TO_SAY
}

/// Lakh-denominated brackets, matching Indian matrimonial-platform convention
/// (brief's positioning is explicitly Indian matrimonial, §1/§7).
enum IncomeRange {
  UNDER_5L
  L5_TO_10L
  L10_TO_20L
  L20_TO_50L
  ABOVE_50L
  PREFER_NOT_TO_SAY
}

// ---------------------------------------------------------------------------
// Module 4 — Lifestyle (brief §15)
// ---------------------------------------------------------------------------
// All fields optional with a PREFER_NOT_TO_SAY-style escape hatch per brief
// §15/§48 ("do not overwhelm users", "never shame"). Free-text fields
// (hobbies/pets/travel) stay as plain strings for MVP rather than tag
// tables — structured tagging is a reasonable post-MVP upgrade for search
// faceting, not required to ship this module.

// ---------------------------------------------------------------------------
// Completion pass — Profile Photos (brief §18/§26, "Profile photograph")
// ---------------------------------------------------------------------------
// storageKey is an opaque object-storage reference, same pattern as
// Verification.documentStorageKey (Module 12) — no upload/signing
// mechanism is implemented (that's an object-storage integration, not a
// schema concern), and the frontend renders a labeled placeholder rather
// than pretending an image URL exists. Visibility is governed by
// PrivacySetting.photoVisibility (Module 13), not a per-photo field —
// the brief's "Request access before viewing private photos" flow is a
// single profile-wide setting, not something that varies photo-to-photo.

model ProfilePhoto {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  storageKey String
  caption    String?
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([profileId])
}

model Lifestyle {
  id            String        @id @default(uuid())
  profileId     String        @unique
  profile       Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  diet          Diet?
  smoking       HabitFrequency?
  drinking      HabitFrequency?
  fitnessRoutine String?
  hobbies       String?
  pets          String?
  travelFrequency String?
  sleepSchedule String?
  socialLifestyle String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum Diet {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  EGGETARIAN
  PREFER_NOT_TO_SAY
}

enum HabitFrequency {
  NEVER
  OCCASIONALLY
  REGULARLY
  PREFER_NOT_TO_SAY
}

// ---------------------------------------------------------------------------
// Module 5 — Previous Marriage & Family/Children (brief §13/§14)
// ---------------------------------------------------------------------------
// This is the most sensitive data on the platform, so it's split by
// visibility at the schema level, not just at the API layer:
//   - `divorceFinalized` (+ the derived public summary built from it) is the
//     only previous-marriage fact ever meant to reach another member by
//     default (brief §13: "Public: Previously married • Divorce finalized").
//   - `marriedYear`/`endedYear`/`additionalInfo` are private-by-default detail
//     that only the owner (and, later, admins handling reports) ever reads.
//     There is deliberately no "court case number" or legal-document field —
//     the brief explicitly says never to display or ask for that.
//
// Deviation from the ER sketch in docs/ARCHITECTURE.md: that doc lists
// "Profile 1—* Child" (one row per child). The actual UI in brief §14 only
// ever collects a children *count* bucket and a single living-arrangement
// value — never per-child details — so a single FamilyDetails row per
// profile is the right shape for what's actually being asked, not an
// under-used one-to-many table.

model PreviousMarriage {
  id               String   @id @default(uuid())
  profileId        String   @unique
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  marriedYear      Int?
  endedYear        Int?
  divorceFinalized Boolean  @default(false)
  /// Private-only free text (brief §13's "Additional information"). Never
  /// returned by PreviousMarriageService.getPublicSummary.
  additionalInfo   String?  @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FamilyDetails {
  id                        String              @id @default(uuid())
  profileId                 String              @unique
  profile                   Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)

  childrenCount             ChildrenCount        @default(NONE)
  childrenLivingArrangement LivingArrangement?

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

enum ChildrenCount {
  NONE
  ONE
  TWO
  THREE_OR_MORE
}

enum LivingArrangement {
  WITH_ME
  WITH_OTHER_PARENT
  SHARED
  OTHER
}

// ---------------------------------------------------------------------------
// Module 6 — Partner Preferences (brief §16)
// ---------------------------------------------------------------------------
// Array columns (Postgres-native, no join table needed) for the genuinely
// multi-select fields brief §16 describes ("Education: Multiple selections",
// "Profession: Multiple selections", previous-marriage preference as a set
// of acceptable circumstances). Free-text fields stay as plain strings for
// MVP, same rationale as Lifestyle.

model PartnerPreference {
  id                          String                       @id @default(uuid())
  profileId                   String                       @unique
  profile                     Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  ageMin                      Int?
  ageMax                      Int?

  preferredCities             String[]
  preferredStates             String[]
  preferredCountries          String[]
  willingToRelocate           Boolean?

  preferredEducation          String[]
  preferredProfessions        String[]
  minIncomeRange              IncomeRange?

  previousMarriagePreferences MarriageStatus[]
  openToAnyMarriageStatus     Boolean                      @default(false)

  childrenPreference          ChildrenPreference           @default(OPEN_TO_EITHER)

  lifestylePreferences        String?
  otherPreferences            String?                      @db.Text

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
}

enum ChildrenPreference {
  NO_CHILDREN
  HAS_CHILDREN
  OPEN_TO_EITHER
}

// ---------------------------------------------------------------------------
// Module 9 — Interests, Matches, Shortlist (brief §22/§23)
// ---------------------------------------------------------------------------

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Interest {
  id           String         @id @default(uuid())
  senderId     String
  sender       User           @relation("InterestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User           @relation("InterestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  status       InterestStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  respondedAt  DateTime?

  match        Match?

  /// One active interest per direction — resending after a decline is a
  /// deliberate product decision for a later module (e.g. a cooldown period),
  /// not something this schema silently allows via duplicate rows today.
  @@unique([senderId, recipientId])
  @@index([recipientId, status])
}

/// Created the moment an Interest is accepted (brief: "Interest Accepted ->
/// Match Created"). userAId/userBId are stored with the numerically/
/// lexically smaller id first (enforced in the service, not the schema) so
/// the @@unique constraint catches a match existing regardless of which
/// direction a future duplicate-creation attempt comes from.
model Match {
  id         String   @id @default(uuid())
  interestId String   @unique
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  userAId    String
  userA      User     @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId    String
  userB      User     @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  conversation Conversation?

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Shortlist {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("ShortlistOwner", fields: [userId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("ShortlistTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, targetUserId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Module 10 — Messaging (brief §24)
// ---------------------------------------------------------------------------
// REST-only for now: text messages and read status. Typing indicators and
// online/last-active status need a persistent connection (WebSocket) that
// doesn't exist in this architecture yet — brief §24 lists them as
// features to build, but building them without realtime infra would mean
// either fake/polled approximations or a half-finished protocol, so they're
// deferred rather than faked. Image sharing, anonymous messaging, and
// public rooms are explicitly out of scope per brief §24 itself.

model Conversation {
  id        String    @id @default(uuid())
  matchId   String    @unique
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 11 — Notifications (brief §34)
// ---------------------------------------------------------------------------
// In-app only for now. Email/SMS/push are separate delivery channels the
// brief lists, but none of them have a configured provider yet (the
// adapter interfaces from Module 2's auth OTP flow — EmailProvider/
// SmsProvider — are the pattern to reuse once one is chosen; push needs a
// device-token model that doesn't exist yet either). `payload` carries
// enough structured data for the frontend to render and link to the
// relevant page (e.g. { interestId } or { conversationId }) without a
// separate lookup.

enum NotificationType {
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
  NEW_MESSAGE
  PROFILE_VIEWED
  PHOTO_REQUEST
  VERIFICATION_COMPLETED
  SUBSCRIPTION_ACTIVATED
  SECURITY_ALERT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Module 12 — Verification (brief §26)
// ---------------------------------------------------------------------------
// Mobile/Email verification already exist as User.mobileVerifiedAt/
// emailVerifiedAt (Module 2's OTP flow) — this module adds Identity
// Verification only. documentStorageKey is an opaque object-storage key,
// never a public URL and never returned to any user other than the
// document owner and reviewing admins — see brief §26: "Never expose
// government ID documents to other users." No file upload/signing
// mechanism is implemented yet (that's an object-storage integration,
// separate from this schema); this models the review workflow around
// whatever key a future upload flow produces. Admin review here is
// API-only — there's no admin dashboard UI until Module 15.

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Verification {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  status             VerificationStatus @default(PENDING)
  documentStorageKey String
  submittedAt        DateTime           @default(now())
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  reviewedByAdmin    User?              @relation("VerificationReviewer", fields: [reviewedByAdminId], references: [id])
  rejectionReason    String?

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Module 13 — Privacy Controls (brief §17)
// ---------------------------------------------------------------------------
// One row per profile holding the visibility level for each sensitive
// category the brief names. showLastActiveStatus/showOnlineStatus are
// modeled now for forward-compatibility even though no last-active/online
// tracking exists yet (no feature currently reads or writes those
// signals) — storing the preference doesn't cost anything and avoids a
// later migration. Contact info (email/mobile) is never returned by any
// endpoint regardless of this setting; contactVisibility exists for a
// future direct-contact-sharing feature, not as the current guard against
// leaking credentials (brief §17: "Never expose phone numbers or emails
// publicly" is already true by construction — no endpoint serializes them).

enum VisibilityLevel {
  EVERYONE
  REGISTERED
  MATCHES
  APPROVED
  NOBODY
}

model PrivacySetting {
  id                          String          @id @default(uuid())
  profileId                   String          @unique
  profile                     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  incomeVisibility            VisibilityLevel @default(MATCHES)
  contactVisibility           VisibilityLevel @default(NOBODY)
  divorceDetailsVisibility    VisibilityLevel @default(MATCHES)
  childrenDetailsVisibility   VisibilityLevel @default(REGISTERED)
  photoVisibility             VisibilityLevel @default(REGISTERED)
  requirePhotoRequestApproval Boolean         @default(false)
  showLastActiveStatus        Boolean         @default(true)
  showOnlineStatus            Boolean         @default(true)

  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Module 14 — Reporting & Blocking (brief §27/§28)
// ---------------------------------------------------------------------------

enum ReportReason {
  FAKE_PROFILE
  SCAM
  HARASSMENT
  ABUSE
  INAPPROPRIATE_CONTENT
  MISREPRESENTATION
  SOLICITATION
  FINANCIAL_SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

model Report {
  id               String       @id @default(uuid())
  reporterId       String
  reporter         User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId   String
  reportedUser     User         @relation("ReportSubject", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason           ReportReason
  description      String?      @db.Text
  status           ReportStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  reviewedAt       DateTime?
  reviewedByAdminId String?
  reviewedByAdmin  User?        @relation("ReportReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([reportedUserId])
  @@index([status])
}

/// Blocking is enforced at the backend across search, discovery, interests,
/// and messaging (brief §28: "Implement this at the backend level, not
/// merely the frontend") — see Module 14 commit notes for exactly which
/// read/write paths currently consult this table. Directional: A blocking
/// B doesn't require B to have blocked A, but every enforcement check is
/// bidirectional (either direction having a row hides/blocks interaction),
/// since the point is mutual non-contact regardless of who initiated it.
model Block {
  id            String   @id @default(uuid())
  blockerId     String
  blocker       User     @relation("BlockInitiator", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlockTarget", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

// ---------------------------------------------------------------------------
// Module 15 — Admin panel & moderation (brief §29-31)
// ---------------------------------------------------------------------------
// Every administrative action is logged here — brief §30: "Every
// administrative action should be logged." targetType/targetId are a loose
// polymorphic reference (e.g. targetType="User", targetId=<user id>) rather
// than a real foreign key, since a single audit log legitimately needs to
// reference many different entity types.

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AuditActor", fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Module 16 — Subscriptions & Payment Architecture (brief §32/§33)
// ---------------------------------------------------------------------------
// No real payment gateway is integrated — PaymentProvider (see
// apps/api/src/modules/subscriptions/providers) is an adapter interface,
// same pattern as Module 2's EmailProvider/SmsProvider, so a real Indian
// payment provider (UPI/cards/net banking/wallets, per brief §33) can be
// plugged in later without touching call sites. Never stores raw card
// data — amountMinorUnits + currency + a provider-issued orderId/
// transactionId is the full payment record, matching brief §33's field
// list exactly.

enum Plan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan               @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments         Payment[]
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  orderId        String        @unique
  transactionId  String?
  plan           Plan
  amountMinorUnits Int         // smallest currency unit (paise for INR) — never a float
  currency       String        @default("INR")
  status         PaymentStatus @default(INITIATED)
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

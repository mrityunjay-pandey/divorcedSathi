# Database
DATABASE_URL=postgresql://user:password@localhost:5432/divorcedsathi

# Auth
AUTH_JWT_SECRET=
AUTH_REFRESH_SECRET=
AUTH_SESSION_TTL=15m
AUTH_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Object storage
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# Email provider (adapter-agnostic)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# SMS/OTP provider (adapter-agnostic)
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# Payments (configured in a later module)
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# Redis
REDIS_URL=redis://localhost:6379

# App
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000
